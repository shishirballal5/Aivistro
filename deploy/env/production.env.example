# AIVISTRO production environment. Copy to your secret store (never into source control). Every value below is a placeholder.
# The API and worker REFUSE to start if a required production rule is broken (see backend/src/config/env.validation.ts).
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=1                       # number of proxies in front of the API (nginx = 1), otherwise rate limits see the proxy IP
CORS_ORIGINS=https://example.com         # exact origins; "*" is refused. Same-origin deployments via nginx need none
SWAGGER_ENABLED=false

# --- secrets (generate: openssl rand -hex 32) ---
APP_SECRET=
METRICS_TOKEN=                           # enables /api/v1/metrics (>=16 chars); scrape with a bearer token

# --- MySQL 8 ---
DB_HOST=
DB_PORT=3306
DB_USERNAME=aivistro
DB_PASSWORD=
DB_NAME=aivistro
DB_SSL=true
DB_POOL_SIZE=20

# --- Redis 7 (maxmemory-policy noeviction) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_DB=0

# --- sign-in and messaging (dev providers are refused in production) ---
WEB_APP_URL=https://example.com
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_AUTHORIZATION=
EMAIL_PROVIDER=http
EMAIL_HTTP_URL=
EMAIL_HTTP_AUTHORIZATION=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# DEV_FIXED_OTP must NOT be set: the app refuses to start with it in production

# --- payments ---
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- storage (S3 or Cloudflare R2; local storage is refused) ---
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                             # R2: https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://cdn.example.com   # public base URL for poster/banner images (bucket or CDN)

# --- video processing (worker host needs ffmpeg + ffprobe on PATH) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_CONCURRENT_STREAMS=2

# --- push and error reporting ---
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
