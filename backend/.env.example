# Copy to .env and fill in. NEVER commit .env. All values below are placeholders for LOCAL development.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API. Must not contain "*" in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:8443
# Reverse-proxy hops to trust for client IPs (0 = none). Set to 1 behind a single load balancer.
TRUST_PROXY_HOPS=0
# Swagger UI at /api/docs. Defaults to on in development, off in production.
# SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ── MySQL 8.x ──
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=aivistro
DB_PASSWORD=change-me-local-only
DB_NAME=aivistro_dev
DB_POOL_SIZE=10
DB_SSL=false
DB_LOGGING=false
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=3000
# Used only by docker-compose to initialise the local MySQL container
MYSQL_ROOT_PASSWORD=change-me-root-local-only

# ── Redis (BullMQ queues, caching, rate-limit state) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ── Secrets and auth ──
# REQUIRED in production, >= 32 chars. Generate with: openssl rand -hex 32
# All signing/encryption keys are derived from it. Rotating it invalidates sessions AND makes stored
# MFA secrets / HLS keys unreadable (see docs/OPERATIONS.md) - do not change it casually.
APP_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TOTP_ISSUER=AIVISTRO
# Viewer web app base URL used in emailed links
WEB_APP_URL=http://localhost:5173
# dev = log/capture only (forbidden in production) | http = POST JSON to *_HTTP_URL | none = disabled
SMS_PROVIDER=dev
# SMS_HTTP_URL=
# SMS_HTTP_AUTHORIZATION=
EMAIL_PROVIDER=dev
# EMAIL_HTTP_URL=
# EMAIL_HTTP_AUTHORIZATION=
# Comma-separated OAuth client IDs; a provider is enabled only when set
# GOOGLE_CLIENT_IDS=
# APPLE_CLIENT_IDS=

# ── Payments ── razorpay | dev (simulator, forbidden in production) | none
PAYMENT_GATEWAY=dev
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── Storage ── s3 (AWS S3 or Cloudflare R2) | local (development only)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=              # e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Where public images (posters, banners, thumbnails) are served from. Development with STORAGE_DRIVER=local: /api/v1/media
# (the API serves images/ itself). With s3: the bucket/CDN origin that exposes images/* publicly, e.g. https://cdn.example.com
# MEDIA_PUBLIC_BASE_URL=/api/v1/media

# ── Video processing / playback ──
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# MAX_UPLOAD_BYTES=
# MAX_VIDEO_SECONDS=
# MAX_CONCURRENT_STREAMS=
# PLAYBACK_SESSION_TTL_SECONDS=
# PLAYBACK_SESSION_MAX_HOURS=
# VIDEO_RETRY_DELAY_MS=

# ── Push notifications ── fcm | dev (forbidden in production) | none
PUSH_PROVIDER=dev
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=

# ── Monitoring ──
# Prometheus endpoint /api/v1/metrics exists only when this is set (>= 16 chars); scrape with a bearer token.
# METRICS_TOKEN=
# SENTRY_DSN=

# ── Tests only ──
# AUTH_RATE_LIMIT_SCALE=1   # >1 relaxes per-route auth limits; leave unset outside tests

# DEVELOPMENT ONLY: make every phone OTP this 6-digit code. Refused in production and when SMS_PROVIDER is not "dev".
# DEV_FIXED_OTP=123456
